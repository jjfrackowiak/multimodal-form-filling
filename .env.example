# Copy to .env and fill in. .env is gitignored; never commit it.

# ---- Gemini auth: Application Default Credentials (editor-service only) ------
# There is NO API key. Auth is ADC — the same mechanism mff-store already uses
# for Firestore/GCS (see the state store section below), so the whole repo now
# has one auth story instead of two.
#
# Set up once, interactively:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project $GOOGLE_CLOUD_PROJECT
#   gcloud services enable aiplatform.googleapis.com
#
# ADC resolves in this order, and nothing in our code branches on which won:
#   1. GOOGLE_APPLICATION_CREDENTIALS  — explicit path to a service-account json
#   2. ~/.config/gcloud/application_default_credentials.json  — the gcloud login
#   3. the GCE/Cloud Run/GKE metadata server — no file, no key, workload identity
#
# (3) is why this is worth doing: in GCP there is no credential to mount, rotate
# or leak. Locally you get (2). Only editor-service reads these; if another
# service needs them, something has moved to the wrong place.
#
# Routes google-genai through Vertex AI rather than the AI Studio endpoint.
# ADK's current samples use GOOGLE_GENAI_USE_ENTERPRISE; GOOGLE_GENAI_USE_VERTEXAI
# is the older name for the same switch and may still be honoured. Set this one.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Pin the model explicitly rather than tracking an alias, so an upstream default
# change cannot silently move the eval baselines.
# Two models, chosen for different jobs.
#
# The editor reviews and composes — that needs judgement, so Gemini.
# The manifest parser only extracts structure from text: cheap, high volume, and the
# validation is ours either way (ADK has no output_validator, so every extractor
# validates its own output). Gemma is the right tool and a fraction of the cost.
#
# Gemma 4 26B A4B IT is served on Vertex as MaaS — serverless, on the standard
# generateContent path, so it needs no Model Garden deployment and survives the
# move to ADC intact. (Gemma 3 would not have: it had no serverless Vertex path.)
# 25.2B total parameters, ~3.8B active per token.
#
# NOTE: Google's docs give the id as `gemma-4-26b-a4b-it`; some third-party
# integrations show a `-maas` suffix. B8's live smoke test is what settles which
# form this project's Vertex region accepts — fix it there, once, and pin it here.
EDITOR_MODEL_ID=gemini-2.5-flash
PARSER_MODEL_ID=gemma-4-26b-a4b-it

# ---- Mailbox ----------------------------------------------------------------
# ONE address, both directions. IMAP_USER, SMTP_USER and MAIL_FROM must all be
# the same mailbox: results are threaded onto the client's original message with
# In-Reply-To, so replies have to come FROM the address clients wrote TO. Split
# them and threading breaks, and anyone replying to a results email reaches
# nobody.
#
# Use a DEDICATED account, never a personal one. The poller reads everything in
# the inbox and treats it as a request — pointed at a personal mailbox it will
# happily try to validate your dinner reservations.
#
# Defaults match docker/compose.dev.yaml (GreenMail). Auth is disabled there, so
# any user/password works and the mailbox is created on first use.
IMAP_HOST=localhost
IMAP_PORT=3143
# Which folder to poll. Never assume INBOX.
#
# Gmail exposes labels as IMAP folders, so a filter routing +forms mail to a
# label lets the poller read ONLY that label and never touch personal mail:
#   IMAP_FOLDER=FormRequests
#
# Note this is our code's discipline, not a permission boundary — an App
# Password grants the whole mailbox regardless. Scoping the folder limits what
# we read, not what we could.
IMAP_FOLDER=INBOX
IMAP_USER=forms@example.test
IMAP_PASSWORD=anything
IMAP_USE_TLS=false

SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USER=forms@example.test
SMTP_PASSWORD=anything
SMTP_USE_TLS=false

# NOTE: there is no "recipient" setting, and there must never be one. Replies go
# to the sender of the incoming request, read off its From/Reply-To headers. The
# service mailbox below is the address CLIENTS WRITE TO; clients receive results
# at whatever address they wrote from. So you use your own everyday address as a
# client and the poller never touches your personal inbox.
#
# The address replies are sent from and that clients write to — same mailbox as
# IMAP_USER above.
MAIL_FROM=forms@example.test
# Display name clients see. "Form Validation <forms@...>" reads better than a
# bare address and makes the reply obviously automated rather than a person.
MAIL_FROM_NAME=Form Validation

# Real provider example (Purelymail). Check their current setup docs for exact
# hostnames — verify_mailbox.py will tell you immediately if they are wrong.
#   IMAP_HOST=imap.purelymail.com   IMAP_PORT=993   IMAP_USE_TLS=true
#   SMTP_HOST=smtp.purelymail.com   SMTP_PORT=465   SMTP_USE_TLS=true
#   IMAP_FOLDER=INBOX

# ---- State store (mff-store, B12) --------------------------------------------
# Unset (the default): mff-store's Firestore/GCS client factories fall through to
# real Application Default Credentials, i.e. real GCP. Set both to point every
# FirestoreClient/GcsClient this process creates at the local emulators instead —
# this is the ONLY switch; nothing in mff-store branches on "am I local".
#
# Defaults below match docker/compose.dev.yaml's firestore/gcs services:
#   docker compose -f docker/compose.dev.yaml up -d firestore gcs
#   python scripts/verify_stack.py
#
# FIRESTORE_EMULATOR_HOST=localhost:8090
# STORAGE_EMULATOR_HOST=http://localhost:4443

# Project id used when talking to the emulators (any string works — the emulator
# does not validate it) or to real Firestore/GCP when the vars above are unset.
MFF_GCP_PROJECT=mff-local
# Bucket every .docx and image is written to. Provisioning it in real GCP is the
# deployment owner's job (Terraform or otherwise) — mff-store assumes it exists.
MFF_GCS_BUCKET=mff-local

# ---- Services ---------------------------------------------------------------
EDITOR_SERVICE_URL=http://localhost:8001
VISION_SERVICE_URL=http://localhost:8002

# ---- Vision placeholder -----------------------------------------------------
# The stand-in answers from the fixture's labelled inventory.
MFF_VISION_INVENTORY=fixtures/fleet-vehicle-return/inventory.yaml

# ---- Safety ------------------------------------------------------------------
# Comma-separated addresses allowed to submit requests. Empty means anyone who
# emails the service mailbox gets a reply, which makes it an open robot that will
# happily answer spam and bounce-loop with another autoresponder. Set this to
# your own address while demoing.
ALLOWED_SENDERS=jot.frackowiak@gmail.com

# Cap on jobs accepted per sender per hour. Cheap protection against a loop.
MAX_JOBS_PER_SENDER_PER_HOUR=10
