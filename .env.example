# Copy to .env and fill in. .env is gitignored; never commit it.

# ---- Gemini (editor-service only) -------------------------------------------
# From https://aistudio.google.com/apikey — the AI Studio key, not a GCP
# service account. Only editor-service reads this; if another service needs it,
# something has moved to the wrong place.
GOOGLE_API_KEY=

# Pin the model explicitly rather than tracking an alias, so an upstream default
# change cannot silently move the eval baselines.
EDITOR_MODEL_ID=gemini-2.5-flash

# ---- Mailbox ----------------------------------------------------------------
# ONE address, both directions. IMAP_USER, SMTP_USER and MAIL_FROM must all be
# the same mailbox: results are threaded onto the client's original message with
# In-Reply-To, so replies have to come FROM the address clients wrote TO. Split
# them and threading breaks, and anyone replying to a results email reaches
# nobody.
#
# Use a DEDICATED account, never a personal one. The poller reads everything in
# the inbox and treats it as a request — pointed at a personal mailbox it will
# happily try to validate your dinner reservations.
#
# Defaults match docker/compose.dev.yaml (GreenMail). Auth is disabled there, so
# any user/password works and the mailbox is created on first use.
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_USER=forms@example.test
IMAP_PASSWORD=anything
IMAP_USE_TLS=false

SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USER=forms@example.test
SMTP_PASSWORD=anything
SMTP_USE_TLS=false

# The address replies are sent from and that clients write to — same mailbox as
# IMAP_USER above.
MAIL_FROM=forms@example.test
# Display name clients see. "Form Validation <forms@...>" reads better than a
# bare address and makes the reply obviously automated rather than a person.
MAIL_FROM_NAME=Form Validation

# ---- Services ---------------------------------------------------------------
EDITOR_SERVICE_URL=http://localhost:8001
VISION_SERVICE_URL=http://localhost:8002

# ---- Vision placeholder -----------------------------------------------------
# The stand-in answers from the fixture's labelled inventory.
FFX_VISION_INVENTORY=fixtures/fleet-vehicle-return/inventory.yaml
