# Order matters: a negation must follow the pattern it excepts, so this file
# must never be sorted. (It was, once, which silently un-tracked .env.example.)
.DS_Store

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
.venv-fixture/

# Node
node_modules/
